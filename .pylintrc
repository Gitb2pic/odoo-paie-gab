[MASTER]
load-plugins=pylint_odoo
score=n
jobs=1
# Analyse statique du code Odoo Community (pas d'exécution)
init-hook='import sys; sys.path.append("/home/ubuntu/odoo/odoo"); sys.path.append("l10n_ga_hr_payroll/lib")'
# Modules du dépôt importés par les modules supérieurs (odoo.addons.l10n_ga_*) : le paquet
# odoo/ de Community est un paquet ordinaire, astroid ne peut pas y greffer ce dépôt. Les
# imports sont vérifiés à l'exécution par les tests Odoo (étape 3).
ignored-modules=odoo.addons.l10n_ga_hr_payroll,odoo.addons.l10n_ga_dgi_edi,odoo.addons.account

[ODOOLINT]
valid-odoo-versions=19.0
manifest-required-authors=
manifest-required-keys=license,version,countries
license-allowed=OPL-1

[MESSAGES CONTROL]
# Style et formatage délégués à ruff ; on garde les contrôles Odoo (pylint-odoo)
# et les erreurs Python.
disable=all
enable=odoolint,
       E,
       unused-import,
       unused-variable,
       dangerous-default-value,
       pointless-statement,
       unreachable,
       redefined-builtin
# no-member (E1101) est retiré sur la ligne de commande du hook (.pre-commit-config.yaml) :
# champs et méthodes des modèles Odoo hérités (_inherit), créés dynamiquement et souvent définis
# dans Enterprise hors du chemin d'analyse → faux positifs selon le découpage des lots de
# pre-commit (constaté à l'étape 2.4). Les tests Odoo couvrent ces accès.
