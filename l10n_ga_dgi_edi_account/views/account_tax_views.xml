<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_tax_view_form_l10n_ga_dgi" model="ir.ui.view">
        <field name="name">account.tax.form.l10n_ga_dgi</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <field name="type_tax_use" position="after">
                <field name="l10n_ga_withholding_kind"/>
            </field>
        </field>
    </record>
    <record id="account_fiscal_position_view_form_l10n_ga_dgi" model="ir.ui.view">
        <field name="name">account.fiscal.position.form.l10n_ga_dgi</field>
        <field name="model">account.fiscal.position</field>
        <field name="inherit_id" ref="account.view_account_position_form"/>
        <field name="arch" type="xml">
            <field name="auto_apply" position="before">
                <field name="l10n_ga_withholding_kind"/>
            </field>
        </field>
    </record>
</odoo>
