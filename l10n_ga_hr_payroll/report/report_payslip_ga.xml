<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Bulletin de salaire gabonais (F7, RG24, plan 2.7 b : mise en page du modèle fourni par Alex).
        Un bulletin validé n'imprime que ses champs figés et ses lignes stockées
        (o._l10n_ga_report_data(), o._l10n_ga_report_rows()), jamais la fiche du jour.
        Posé comme report_id de la structure « Gabon — Employé » : le standard l'utilise pour
        l'impression et le PDF joint (E/hr_payroll/models/hr_payslip.py:535-543).
    -->
    <!-- A4, marges de 8 mm : pas d'en-tête standard (le cadre employeur du modèle le remplace). -->
    <record id="paperformat_l10n_ga_payslip" model="report.paperformat">
        <field name="name">A4 bulletin de paie (Gabon)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_payslip_ga" model="ir.actions.report">
        <field name="name">Bulletin de paie (Gabon)</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ga_hr_payroll.report_payslip_ga_lang</field>
        <field name="report_file">l10n_ga_hr_payroll.report_payslip_ga_lang</field>
        <field name="print_report_name">'Bulletin - %s' % (object.name)</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_l10n_ga_payslip"/>
        <field name="attachment"></field>
        <field name="attachment_use" eval="False"/>
    </record>

    <record id="structure_ga_employee" model="hr.payroll.structure">
        <field name="report_id" ref="action_report_payslip_ga"/>
    </record>

    <template id="report_payslip_ga">
        <!-- Article sans en-tête ni pied standard : le cadre employeur du modèle les remplace
             (web.basic_layout ouvrirait un second html_container). -->
        <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id"
             t-att-data-oe-lang="o.env.context.get('lang')">
            <t t-set="data" t-value="o._l10n_ga_report_data()"/>
            <t t-set="rows" t-value="o._l10n_ga_report_rows(data)"/>
            <t t-set="fmt" t-value="o._l10n_ga_fmt"/>
            <t t-set="fmt_rate" t-value="o._l10n_ga_fmt_rate"/>
            <t t-set="company" t-value="o.company_id"/>
            <div class="page o_l10n_ga_payslip" style="font-size: 12px; line-height: 1.35;">
                <style>
                    .o_l10n_ga_payslip table { width: 100%; border-collapse: collapse; }
                    .o_l10n_ga_payslip .ga-box { border: 1px solid #000; border-radius: 8px; padding: 4px 8px; }
                    .o_l10n_ga_payslip .ga-grid th, .o_l10n_ga_payslip .ga-grid td { border: 1px solid #000; padding: 1px 4px; }
                    .o_l10n_ga_payslip .ga-lines td { border-left: 1px solid #000; border-right: 1px solid #000; padding: 2px 5px; }
                    .o_l10n_ga_payslip .ga-lines th { border: 1px solid #000; padding: 2px 4px; text-align: center; }
                    .o_l10n_ga_payslip .ga-lines { border-bottom: 1px solid #000; }
                    .o_l10n_ga_payslip .ga-total td { font-weight: bold; padding-top: 6px; padding-bottom: 6px; }
                    .o_l10n_ga_payslip .ga-info td { font-style: italic; }
                    .o_l10n_ga_payslip .ga-num { text-align: right; white-space: nowrap; }
                    .o_l10n_ga_payslip .ga-shade { background-color: #eee; padding: 6px 8px; }
                    .o_l10n_ga_payslip .ga-label { font-weight: bold; padding-right: 6px; white-space: nowrap; }
                </style>

                <!-- En-tête : cadre employeur à gauche, titre et identité à droite -->
                <table id="l10n_ga_header">
                    <tr>
                        <td style="width: 45%; vertical-align: top;">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 60px;" alt="Logo"/>
                            <div class="ga-box" id="l10n_ga_employer">
                                <strong t-out="company.name"/><br/>
                                <t t-if="company.street"><span t-out="company.street"/><br/></t>
                                <t t-if="company.street2"><span t-out="company.street2"/><br/></t>
                                <t t-if="company.zip or company.city"><span t-out="company.zip or ''"/> <span t-out="company.city or ''"/><br/></t>
                                <t t-if="company.phone">Tél. : <span t-out="company.phone"/><br/></t>
                                NIF : <span t-out="data['l10n_ga_company_nif'] or '—'"/> —
                                CNSS employeur : <span t-out="data['l10n_ga_company_cnss'] or '—'"/>
                                <t t-if="data['l10n_ga_company_cnamgs']"> — CNAMGS : <span t-out="data['l10n_ga_company_cnamgs']"/></t>
                            </div>
                        </td>
                        <td style="width: 55%; vertical-align: top; padding-left: 12px;">
                            <div style="text-align: center; font-size: 19px; margin: 0 0 6px 0;"><strong>BULLETIN DE SALAIRE</strong></div>
                            <table id="l10n_ga_period">
                                <tr>
                                    <td class="ga-label">Période</td>
                                    <td><span t-out="o.date_from.strftime('%d/%m/%Y')"/> au <span t-out="o.date_to.strftime('%d/%m/%Y')"/></td>
                                    <td class="ga-label">Paiement</td>
                                    <td t-out="o.l10n_ga_payment_date and o.l10n_ga_payment_date.strftime('%d/%m/%Y') or ''"/>
                                    <td class="ga-label">Édité le</td>
                                    <td t-out="data['edited'].strftime('%d/%m/%Y')"/>
                                </tr>
                            </table>
                            <table id="l10n_ga_identity" style="margin-top: 4px;">
                                <tr>
                                    <td class="ga-label">Matricule</td><td t-out="data['l10n_ga_registration_number'] or ''"/>
                                    <td class="ga-label">Horaires</td><td class="ga-num" t-out="fmt(data['month_hours'], 2)"/>
                                </tr>
                                <tr>
                                    <td class="ga-label">Date d’embauche</td>
                                    <td t-out="data['l10n_ga_hire_date'] and data['l10n_ga_hire_date'].strftime('%d/%m/%Y') or ''"/>
                                    <td class="ga-label">Nombre d’enfants</td><td class="ga-num" t-out="data['l10n_ga_children_used'] or 0"/>
                                </tr>
                                <tr>
                                    <td class="ga-label">N° CNSS</td><td t-out="data['l10n_ga_ssnid'] or ''"/>
                                    <td class="ga-label">Nombre de parts</td><td class="ga-num" t-out="fmt_rate(data['l10n_ga_tax_parts_used'])"/>
                                </tr>
                                <tr>
                                    <td class="ga-label">N° CNAMGS</td><td t-out="data['l10n_ga_cnamgs_number'] or ''"/>
                                    <td class="ga-label">NIF</td><td t-out="data['l10n_ga_nif'] or ''"/>
                                </tr>
                                <tr>
                                    <td class="ga-label">Situation familiale</td><td t-out="data['marital_label'] or ''"/>
                                    <td class="ga-label">Ancienneté depuis</td>
                                    <td t-out="data['l10n_ga_seniority_date'] and data['l10n_ga_seniority_date'].strftime('%d/%m/%Y') or ''"/>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align: top; padding-top: 6px;">
                            <table id="l10n_ga_job">
                                <tr><td class="ga-label">Emploi</td><td t-out="data['l10n_ga_job_title'] or ''"/></tr>
                                <tr><td class="ga-label">Direction</td><td t-out="data['l10n_ga_direction'] or ''"/></tr>
                                <tr><td class="ga-label">Département</td><td t-out="data['l10n_ga_department'] or ''"/></tr>
                                <tr><td class="ga-label">Catégorie</td><td t-out="data['l10n_ga_grade'] or ''"/></tr>
                                <tr>
                                    <td class="ga-label">Paiement</td>
                                    <td>
                                        par <span t-out="(data['payment_mode_label'] or '').lower()"/>
                                        <span t-out="data['l10n_ga_bank_name'] or ''"/>
                                        <t t-if="data['l10n_ga_bank_account']"><br/><span t-out="data['l10n_ga_bank_account']"/></t>
                                    </td>
                                </tr>
                            </table>
                        </td>
                        <td class="ga-shade" style="vertical-align: top;" id="l10n_ga_employee">
                            <strong t-out="data['l10n_ga_employee_name']"/><br/><br/>
                            <span t-out="data['l10n_ga_employee_city'] or ''"/>
                        </td>
                    </tr>
                </table>

                <p t-if="not data['frozen']" class="text-danger" style="font-weight: bold; margin: 4px 0;" id="l10n_ga_not_validated">
                    Bulletin non validé — document sans valeur légale.
                </p>

                <!-- Rubriques : parts salariale et patronale d'un organisme sur la même ligne -->
                <table class="ga-lines" id="l10n_ga_lines" style="margin-top: 8px;">
                    <thead>
                        <tr>
                            <th colspan="2" style="border: none;"/>
                            <th colspan="3">Gains et cotisations salariales</th>
                            <th colspan="2">Cotisations patronales</th>
                        </tr>
                        <tr>
                            <th style="width: 7%;">Code</th>
                            <th style="width: 33%;">Libellé rubrique</th>
                            <th style="width: 14%;">Base ou nombre</th>
                            <th style="width: 10%;">Taux</th>
                            <th style="width: 13%;">Montant</th>
                            <th style="width: 8%;">Taux</th>
                            <th style="width: 15%;">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="rows" t-as="row" t-att-class="{'total': 'ga-total', 'info': 'ga-info'}.get(row['style'], '')">
                            <td t-out="row['code']"/>
                            <td t-att-style="'padding-left: 24px;' if row['style'] == 'total' else None" t-out="row['name']"/>
                            <td class="ga-num" t-out="fmt(row['base'], row['base_digits'])"/>
                            <td class="ga-num" t-out="fmt(row['rate'], 2) if row['base_digits'] else fmt_rate(row['rate'])"/>
                            <td class="ga-num" t-out="fmt(row['amount'])"/>
                            <td class="ga-num" t-out="fmt_rate(row['employer_rate'])"/>
                            <td class="ga-num" t-out="fmt(row['employer_amount'])"/>
                        </tr>
                    </tbody>
                </table>

                <p style="margin: 6px 0;" id="l10n_ga_mentions">
                    Pour vous aider à faire valoir vos droits, conservez ce bulletin sans limitation de durée.
                    <t t-if="data['l10n_ga_rounding_carry']">
                        Reliquat d’arrondi reporté au mois suivant : <span t-out="fmt(data['l10n_ga_rounding_carry'])"/> FCFA.
                    </t>
                </p>

                <!-- Cumuls et net à payer -->
                <table id="l10n_ga_cumuls">
                    <tr>
                        <td style="width: 80%; vertical-align: top;">
                            <table class="ga-grid">
                                <tr>
                                    <th>Cumuls</th><th>Brut imposable</th><th>Charges sal.</th><th>Tot. av. nat.</th>
                                    <th>TCS</th><th>IRPP</th><th>FNH</th><th>Ind. non impos.</th>
                                </tr>
                                <tr>
                                    <th>Mois</th>
                                    <td class="ga-num" t-out="fmt(data['l10n_ga_taxable_gross'])"/>
                                    <td class="ga-num" t-out="fmt(data['l10n_ga_employee_contributions'])"/>
                                    <td class="ga-num" t-out="fmt(data['l10n_ga_benefits_in_kind'])"/>
                                    <td class="ga-num" t-out="fmt(data['l10n_ga_tcs'])"/>
                                    <td class="ga-num" t-out="fmt(data['l10n_ga_irpp_withheld'])"/>
                                    <td class="ga-num" t-out="fmt(data['l10n_ga_fnh_employer'])"/>
                                    <td class="ga-num" t-out="fmt(data['l10n_ga_tax_exempt'])"/>
                                </tr>
                                <tr>
                                    <th>Année</th>
                                    <td class="ga-num" t-out="fmt(data['l10n_ga_ytd_taxable'])"/>
                                    <td class="ga-num" t-out="fmt(data['l10n_ga_ytd_contributions'])"/>
                                    <td class="ga-num" t-out="fmt(data['l10n_ga_ytd_benefits'])"/>
                                    <td class="ga-num" t-out="fmt(data['l10n_ga_ytd_tcs'])"/>
                                    <td class="ga-num" t-out="fmt(data['l10n_ga_ytd_irpp'])"/>
                                    <td class="ga-num" t-out="fmt(data['l10n_ga_ytd_fnh'])"/>
                                    <td class="ga-num" t-out="fmt(data['l10n_ga_ytd_tax_exempt'])"/>
                                </tr>
                            </table>
                        </td>
                        <td style="width: 20%; vertical-align: top; padding-left: 8px;">
                            <table class="ga-grid" id="l10n_ga_net_pay">
                                <tr><th style="text-align: center;">Net à payer</th></tr>
                                <tr><td class="ga-num" style="font-size: 17px; font-weight: bold;" t-out="fmt(data['net_pay'])"/></tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- Congés et émargement -->
                <table class="ga-grid" id="l10n_ga_leaves" style="margin-top: 8px;">
                    <tr>
                        <th style="width: 10%;"/><th style="width: 15%;">Base congés</th><th style="width: 15%;">Jours de congé</th>
                        <th style="width: 30%;">Émargement employeur</th><th style="width: 30%;">Émargement employé(e)</th>
                    </tr>
                    <tr>
                        <th>Acquis</th>
                        <td class="ga-num" t-out="fmt(data['l10n_ga_leave_base'])"/>
                        <td class="ga-num" t-out="fmt(data['l10n_ga_leave_acquired'], 2)"/>
                        <td rowspan="3"/><td rowspan="3"/>
                    </tr>
                    <tr>
                        <th>Pris</th><td/>
                        <td class="ga-num" t-out="fmt(data['l10n_ga_leave_taken'], 2)"/>
                    </tr>
                    <tr>
                        <th>Solde</th><td/>
                        <td class="ga-num" t-out="fmt(data['l10n_ga_leave_balance'], 2)"/>
                    </tr>
                </table>
            </div>
        </div>
    </template>

    <template id="report_payslip_ga_lang">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang=o.employee_id.lang or o.env.lang)"/>
                <t t-call="l10n_ga_hr_payroll.report_payslip_ga" t-lang="o.env.lang"/>
            </t>
        </t>
    </template>
</odoo>
