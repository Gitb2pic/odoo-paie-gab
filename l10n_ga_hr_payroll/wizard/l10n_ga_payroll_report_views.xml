<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- États de paie Excel (F2, F13) : livre de paie et état des charges, virements, billetage. -->
    <record id="l10n_ga_payroll_report_view_form" model="ir.ui.view">
        <field name="name">l10n_ga.payroll.report.form</field>
        <field name="model">l10n_ga.payroll.report</field>
        <field name="arch" type="xml">
            <form string="États de paie">
                <field name="filename" invisible="1"/>
                <group>
                    <group>
                        <field name="report_type" widget="radio"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="payslip_run_id"/>
                        <field name="date_from" invisible="payslip_run_id"/>
                        <field name="date_to" invisible="payslip_run_id"/>
                    </group>
                </group>
                <group invisible="not file">
                    <field name="file" filename="filename"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Générer" class="btn-primary"/>
                    <button special="cancel" string="Fermer" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_ga_payroll_report_action" model="ir.actions.act_window">
        <field name="name">États de paie (Gabon)</field>
        <field name="res_model">l10n_ga.payroll.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_l10n_ga_payroll_report"
        name="États de paie (Gabon)"
        action="l10n_ga_payroll_report_action"
        parent="hr_payroll.menu_hr_payroll_report"
        groups="hr_payroll.group_hr_payroll_user"
        sequence="5"/>
</odoo>
