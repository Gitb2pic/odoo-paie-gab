<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Import Excel des variables du mois (F3) : modèle, fichier, aperçu, import. -->
    <record id="l10n_ga_payslip_input_import_view_form" model="ir.ui.view">
        <field name="name">l10n_ga.payslip.input.import.form</field>
        <field name="model">l10n_ga.payslip.input.import</field>
        <field name="arch" type="xml">
            <form string="Importer les variables du mois">
                <field name="state" invisible="1"/>
                <field name="template_filename" invisible="1"/>
                <field name="import_filename" invisible="1"/>
                <group>
                    <field name="payslip_run_id" readonly="1"/>
                    <field name="template_file" filename="template_filename" invisible="not template_file"/>
                    <field name="import_file" filename="import_filename" readonly="state == 'done'"/>
                </group>
                <group invisible="state == 'upload'">
                    <field name="valid_count"/>
                    <field name="rejected_count"/>
                </group>
                <field name="issues_text" invisible="not issues_text" nolabel="1"/>
                <footer>
                    <button name="action_generate_template" type="object" string="Télécharger le modèle"
                            class="btn-secondary" invisible="state == 'done'"/>
                    <button name="action_preview" type="object" string="Aperçu" class="btn-secondary"
                            invisible="not import_file or state == 'done'"/>
                    <button name="action_import" type="object" string="Importer" class="btn-primary"
                            invisible="state != 'preview' or not valid_count"/>
                    <button special="cancel" string="Fermer" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
