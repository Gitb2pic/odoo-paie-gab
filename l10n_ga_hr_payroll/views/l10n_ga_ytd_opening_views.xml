<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cumuls d'ouverture de l'année de bascule (F12, RG25). -->
    <record id="l10n_ga_ytd_opening_view_list" model="ir.ui.view">
        <field name="name">l10n_ga.ytd.opening.list</field>
        <field name="model">l10n_ga.ytd.opening</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="year"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="gross" sum="Total"/>
                <field name="taxable" sum="Total"/>
                <field name="irpp_base" optional="hide"/>
                <field name="irpp" sum="Total"/>
                <field name="tcs" optional="show"/>
                <field name="cnss" optional="show"/>
                <field name="bonus_exempt" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="l10n_ga_ytd_opening_view_form" model="ir.ui.view">
        <field name="name">l10n_ga.ytd.opening.form</field>
        <field name="model">l10n_ga.ytd.opening</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Salarié et période">
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="year"/>
                            <label for="date_from" string="Période couverte"/>
                            <div class="o_row">
                                <field name="date_from" class="oe_inline"/>
                                <i class="fa fa-long-arrow-right mx-2" aria-label="au" title="au"/>
                                <field name="date_to" class="oe_inline"/>
                            </div>
                        </group>
                        <group string="Cumuls repris">
                            <field name="gross"/>
                            <field name="taxable"/>
                            <field name="irpp_base"/>
                            <field name="irpp"/>
                            <field name="tcs"/>
                            <field name="cnss"/>
                            <field name="bonus_exempt"/>
                            <field name="contributions"/>
                            <field name="benefits"/>
                            <field name="fnh"/>
                            <field name="tax_exempt"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Origine des cumuls (ancien logiciel, bulletins papier…)"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ga_ytd_opening_view_search" model="ir.ui.view">
        <field name="name">l10n_ga.ytd.opening.search</field>
        <field name="model">l10n_ga.ytd.opening</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="year"/>
                <group>
                    <filter name="group_year" string="Année" context="{'group_by': 'year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_ga_ytd_opening_action" model="ir.actions.act_window">
        <field name="name">Cumuls d’ouverture</field>
        <field name="res_model">l10n_ga.ytd.opening</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_l10n_ga_ytd_opening"
        name="Cumuls d’ouverture"
        action="l10n_ga_ytd_opening_action"
        parent="hr_payroll.menu_hr_payroll_employees"
        groups="hr_payroll.group_hr_payroll_user"
        sequence="85"/>
</odoo>
