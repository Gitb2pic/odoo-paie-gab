<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ga_employee_loan_view_form" model="ir.ui.view">
        <field name="name">l10n_ga.employee.loan.form</field>
        <field name="model">l10n_ga.employee.loan</field>
        <field name="arch" type="xml">
            <form string="Prêt salarié">
                <header>
                    <button name="action_compute_schedule" type="object" string="Calculer l’échéancier"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approuver" class="oe_highlight"
                            invisible="state != 'draft'" groups="hr_payroll.group_hr_payroll_manager"/>
                    <button name="action_early_repayment" type="object" string="Remboursement anticipé"
                            invisible="state not in ('approved', 'running')"/>
                    <button name="action_draft" type="object" string="Remettre en brouillon"
                            invisible="state not in ('approved', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state not in ('draft', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,running,paid"/>
                </header>
                <sheet>
                    <div role="alert" class="alert alert-warning" invisible="state != 'draft' or not eligibility_issues">
                        <strong>Conditions d’octroi non remplies (RG20)</strong>
                        <field name="eligibility_issues" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="installment_count" readonly="state != 'draft'"/>
                            <field name="first_due_date" readonly="state != 'draft'"/>
                            <field name="installment_amount"/>
                            <field name="remaining_amount"/>
                            <field name="withheld_amount"/>
                        </group>
                    </group>
                    <group string="Dérogation RH">
                        <field name="derogation" readonly="state != 'draft'"/>
                        <field name="derogation_reason" invisible="not derogation" required="derogation"
                               readonly="state != 'draft'"/>
                        <field name="derogation_user_id" invisible="not derogation_user_id"/>
                        <field name="derogation_date" invisible="not derogation_date"/>
                    </group>
                    <notebook>
                        <page name="schedule" string="Échéancier">
                            <field name="line_ids" readonly="state not in ('draft', 'approved', 'running')">
                                <list editable="bottom" decoration-muted="state in ('postponed', 'repaid')"
                                      decoration-success="state == 'withheld'">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="due_date" readonly="state != 'to_pay' or payslip_id"/>
                                    <field name="amount" sum="Total" readonly="state != 'to_pay' or payslip_id"/>
                                    <field name="state" readonly="1"/>
                                    <field name="payslip_id"/>
                                    <field name="note"/>
                                    <button name="action_postpone" type="object" string="Reporter" icon="fa-forward"
                                            invisible="state != 'to_pay' or payslip_id or parent.state not in ('approved', 'running')"/>
                                </list>
                            </field>
                        </page>
                        <page name="note" string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ga_employee_loan_view_list" model="ir.ui.view">
        <field name="name">l10n_ga.employee.loan.list</field>
        <field name="model">l10n_ga.employee.loan</field>
        <field name="arch" type="xml">
            <list string="Prêts salariés" decoration-muted="state in ('paid', 'cancelled')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="installment_amount"/>
                <field name="remaining_amount" sum="Total"/>
                <field name="derogation" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="l10n_ga_employee_loan_view_search" model="ir.ui.view">
        <field name="name">l10n_ga.employee.loan.search</field>
        <field name="model">l10n_ga.employee.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="active_loans" string="En cours" domain="[('state', 'in', ('approved', 'running'))]"/>
                <filter name="draft" string="Brouillons" domain="[('state', '=', 'draft')]"/>
                <filter name="derogation" string="Avec dérogation" domain="[('derogation', '=', True)]"/>
                <group>
                    <filter name="group_employee" string="Salarié" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_ga_employee_loan_action" model="ir.actions.act_window">
        <field name="name">Prêts salariés</field>
        <field name="res_model">l10n_ga.employee.loan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_loans': 1}</field>
    </record>

    <record id="l10n_ga_loan_early_repayment_view_form" model="ir.ui.view">
        <field name="name">l10n_ga.loan.early.repayment.form</field>
        <field name="model">l10n_ga.loan.early.repayment</field>
        <field name="arch" type="xml">
            <form string="Remboursement anticipé">
                <group>
                    <field name="loan_id" readonly="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="remaining_amount"/>
                    <field name="amount"/>
                    <field name="mode" widget="radio"/>
                    <field name="date"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmer" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem
        id="menu_l10n_ga_employee_loan"
        name="Prêts salariés"
        action="l10n_ga_employee_loan_action"
        parent="hr_payroll.menu_hr_payroll_employees"
        groups="hr_payroll.group_hr_payroll_user"
        sequence="80"/>
</odoo>
