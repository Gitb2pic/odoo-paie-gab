<?xml version="1.0" encoding="utf-8"?>
<!--
    Groupes : ceux de hr_payroll sont réutilisés (group_hr_payroll_user / _manager, sprint 0 point 10).
    Règles multi-société des nouveaux modèles : company_id in company_ids (règle d'or 11).
-->
<odoo>
    <record id="rule_l10n_ga_collective_agreement_company" model="ir.rule">
        <field name="name">Convention collective : sociétés autorisées</field>
        <field name="model_id" ref="model_l10n_ga_collective_agreement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_ga_overtime_rate_company" model="ir.rule">
        <field name="name">Taux d'heures supplémentaires : sociétés autorisées</field>
        <field name="model_id" ref="model_l10n_ga_overtime_rate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_ga_agreement_grade_company" model="ir.rule">
        <field name="name">Grade de convention : sociétés autorisées</field>
        <field name="model_id" ref="model_l10n_ga_agreement_grade"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_ga_employee_loan_company" model="ir.rule">
        <field name="name">Prêt salarié : sociétés autorisées</field>
        <field name="model_id" ref="model_l10n_ga_employee_loan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_ga_employee_loan_line_company" model="ir.rule">
        <field name="name">Échéance de prêt : sociétés autorisées</field>
        <field name="model_id" ref="model_l10n_ga_employee_loan_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
