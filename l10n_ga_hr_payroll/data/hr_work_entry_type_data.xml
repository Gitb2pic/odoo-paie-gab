        <record id="work_entry_type_ga_hs_j" model="hr.work.entry.type">
            <field name="name">Heures supplémentaires de jour</field>
            <field name="code">GA_HS_J</field>
            <field name="display_code">HSJ</field>
            <field name="country_id" ref="base.ga"/>
