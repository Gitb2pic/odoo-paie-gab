<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Catégories standard réutilisées : BASIC, ALW, GROSS, DED, NET, COMP (hr_payroll). -->
        <record id="category_ga_aik" model="hr.salary.rule.category">
            <field name="name">Avantages en nature</field>
            <field name="code">GA_AIK</field>
            <field name="country_id" ref="base.ga"/>
            <field name="note">Compris dans le brut (assiettes sociale et fiscale), jamais dans le net : non versés.</field>
        </record>
        <record id="category_ga_soc" model="hr.salary.rule.category">
            <field name="name">Retenues sociales</field>
            <field name="code">GA_SOC</field>
            <field name="parent_id" ref="hr_payroll.DED"/>
            <field name="country_id" ref="base.ga"/>
        </record>
        <record id="category_ga_tax" model="hr.salary.rule.category">
            <field name="name">Retenues fiscales</field>
            <field name="code">GA_TAX</field>
            <field name="parent_id" ref="hr_payroll.DED"/>
            <field name="country_id" ref="base.ga"/>
        </record>
        <record id="category_ga_employer" model="hr.salary.rule.category">
            <field name="name">Charges patronales</field>
            <field name="code">GA_EMPLOYER</field>
            <field name="parent_id" ref="hr_payroll.COMP"/>
            <field name="country_id" ref="base.ga"/>
        </record>
        <record id="category_ga_cash" model="hr.salary.rule.category">
            <field name="name">Arrondi espèces</field>
            <field name="code">GA_CASH</field>
            <field name="country_id" ref="base.ga"/>
            <field name="note">Après le net unique (F2) : reliquat précédent, arrondi, net à payer.</field>
        </record>
    </data>
</odoo>
