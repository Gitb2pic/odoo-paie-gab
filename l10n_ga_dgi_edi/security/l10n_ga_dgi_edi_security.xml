<?xml version="1.0" encoding="utf-8"?>
<!--
    Groupes des déclarations (prompt 04, 4.1) : « Déclarant fiscal » (valide, dépose, règle) implique
    le gestionnaire de paie (calcule) ; « Responsable » (types, cases, suppression) implique le déclarant.
    Règles multi-société des nouveaux modèles : company_id in company_ids (règle d'or 11).
-->
<odoo>
    <data noupdate="1">
        <record id="res_groups_privilege_l10n_ga_declaration" model="res.groups.privilege">
            <field name="name">Déclarations Gabon</field>
            <field name="sequence">17</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
        </record>
        <record id="group_l10n_ga_declarant" model="res.groups">
            <field name="name">Déclarant fiscal</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_l10n_ga_declaration"/>
            <field name="implied_ids" eval="[(4, ref('hr_payroll.group_hr_payroll_user'))]"/>
            <field name="comment">Valide les déclarations, les marque déposées et payées.</field>
        </record>
        <record id="group_l10n_ga_declaration_manager" model="res.groups">
            <field name="name">Responsable</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_l10n_ga_declaration"/>
            <field name="implied_ids" eval="[(4, ref('group_l10n_ga_declarant'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Configure les imprimés et supprime les déclarations brouillon.</field>
        </record>
    </data>

    <record id="rule_l10n_ga_declaration_company" model="ir.rule">
        <field name="name">Déclaration : sociétés autorisées</field>
        <field name="model_id" ref="model_l10n_ga_declaration"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_ga_declaration_line_company" model="ir.rule">
        <field name="name">Valeur de case : sociétés autorisées</field>
        <field name="model_id" ref="model_l10n_ga_declaration_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_ga_declaration_detail_company" model="ir.rule">
        <field name="name">Détail de déclaration : sociétés autorisées</field>
        <field name="model_id" ref="model_l10n_ga_declaration_detail"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_ga_declaration_payment_company" model="ir.rule">
        <field name="name">Quittance de déclaration : sociétés autorisées</field>
        <field name="model_id" ref="model_l10n_ga_declaration_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
