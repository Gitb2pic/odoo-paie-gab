<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ga_declaration_view_list" model="ir.ui.view">
        <field name="name">l10n_ga.declaration.list</field>
        <field name="model">l10n_ga.declaration</field>
        <field name="arch" type="xml">
            <list decoration-danger="blocking_count" decoration-muted="state == 'cancel'"
                  decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="type_id"/>
                <field name="authority" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="due_date" widget="remaining_days" invisible="state in ('filed', 'paid', 'cancel')"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_residual" optional="show" sum="Reste"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="blocking_count" optional="show"/>
                <field name="filing_number" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge" decoration-info="state in ('draft', 'computed')"
                       decoration-warning="state == 'validated'" decoration-success="state in ('filed', 'paid')"/>
            </list>
        </field>
    </record>

    <record id="l10n_ga_declaration_view_form" model="ir.ui.view">
        <field name="name">l10n_ga.declaration.form</field>
        <field name="model">l10n_ga.declaration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Calculer" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_compute" type="object" string="Recalculer" invisible="state != 'computed'"/>
                    <button name="action_validate" type="object" string="Valider" class="btn-primary"
                            invisible="state != 'computed'" groups="l10n_ga_dgi_edi.group_l10n_ga_declarant"/>
                    <button name="action_mark_filed" type="object" string="Marquer déposée" class="btn-primary"
                            invisible="state != 'validated'" groups="l10n_ga_dgi_edi.group_l10n_ga_declarant"/>
                    <button name="action_mark_paid" type="object" string="Marquer payée" class="btn-primary"
                            invisible="state != 'filed'" groups="l10n_ga_dgi_edi.group_l10n_ga_declarant"/>
                    <button name="action_unvalidate" type="object" string="Annuler la validation"
                            invisible="state != 'validated'" groups="l10n_ga_dgi_edi.group_l10n_ga_declarant"
                            confirm="L'instantané et ses fichiers seront retirés. Continuer ?"/>
                    <button name="action_create_rectification" type="object" string="Créer une rectificative"
                            invisible="state not in ('filed', 'paid')"/>
                    <button name="action_reset_draft" type="object" string="Remettre en brouillon"
                            invisible="state not in ('computed', 'cancel')"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state not in ('draft', 'computed')"/>
                    <button name="action_check_integrity" type="object" string="Vérifier l'empreinte"
                            invisible="not sha256"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,validated,filed,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Rectificative" bg_color="text-bg-warning"
                            invisible="not rectified_id"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="due_date" readonly="state not in ('draft', 'computed')"/>
                            <field name="rectified_id" invisible="not rectified_id"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="amount_paid" invisible="not payment_ids"/>
                            <field name="amount_residual" invisible="not payment_ids"/>
                            <field name="blocking_count" invisible="not blocking_count" decoration-danger="1"/>
                            <field name="warning_count" invisible="not warning_count"/>
                            <field name="filing_date" readonly="state not in ('validated', 'filed')"/>
                            <field name="filing_number" readonly="state not in ('validated', 'filed')"/>
                            <field name="validated_date" invisible="not validated_date"/>
                            <field name="validated_by_id" invisible="not validated_by_id"/>
                            <field name="sha256" invisible="not sha256"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cases" name="boxes">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="value_kind" optional="hide"/>
                                    <field name="value_amount" invisible="value_kind != 'amount'" sum="Total"/>
                                    <field name="value_number" invisible="value_kind not in ('number', 'rate')"/>
                                    <field name="value_text" invisible="value_kind != 'text'"/>
                                    <field name="value_date" invisible="value_kind != 'date'"/>
                                    <field name="value_blank" optional="hide"/>
                                    <field name="is_total" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Détails" name="details">
                            <field name="detail_ids" readonly="1">
                                <list>
                                    <field name="box_id"/>
                                    <field name="label"/>
                                    <field name="employee_id" optional="hide"/>
                                    <field name="partner_id" optional="hide"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Quittances" name="payments" invisible="state not in ('validated', 'filed', 'paid')">
                            <field name="payment_ids" readonly="state not in ('validated', 'filed', 'paid')">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="receipt_number"/>
                                    <field name="kind"/>
                                    <field name="mode"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="attachment_ids" widget="many2many_binary"/>
                                    <field name="note" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Anomalies" name="issues">
                            <field name="issue_ids" readonly="1"
                                   context="{'list_view_ref': 'l10n_ga_dgi_edi.l10n_ga_check_issue_view_list_declaration'}"/>
                        </page>
                        <page string="Fichiers" name="files" invisible="not snapshot_attachment_ids">
                            <field name="snapshot_attachment_ids" widget="many2many_binary" readonly="1"/>
                        </page>
                        <page string="Rectificatives" name="rectifications" invisible="not rectification_ids">
                            <field name="rectification_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="amount_total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ga_declaration_view_kanban" model="ir.ui.view">
        <field name="name">l10n_ga.declaration.kanban</field>
        <field name="model">l10n_ga.declaration</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_create="0" group_delete="0" group_edit="0"
                    quick_create="0" records_draggable="0">
                <field name="currency_id"/>
                <field name="blocking_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <field name="activity_ids" widget="kanban_activity"/>
                        </div>
                        <field name="type_id" class="text-muted"/>
                        <div class="d-flex justify-content-between">
                            <field name="due_date" widget="remaining_days"/>
                            <field name="amount_total"/>
                        </div>
                        <span t-if="record.blocking_count.raw_value" class="badge text-bg-danger">
                            <t t-out="record.blocking_count.value"/> anomalie(s) bloquante(s)
                        </span>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="l10n_ga_declaration_view_calendar" model="ir.ui.view">
        <field name="name">l10n_ga.declaration.calendar</field>
        <field name="model">l10n_ga.declaration</field>
        <field name="arch" type="xml">
            <calendar date_start="due_date" mode="month" color="type_id" quick_create="0" create="0">
                <field name="type_id" filters="1"/>
                <field name="state"/>
                <field name="amount_total"/>
            </calendar>
        </field>
    </record>

    <record id="l10n_ga_declaration_view_search" model="ir.ui.view">
        <field name="name">l10n_ga.declaration.search</field>
        <field name="model">l10n_ga.declaration</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="type_id"/>
                <field name="filing_number"/>
                <filter name="to_file" string="À déposer" domain="[('state', 'in', ('draft', 'computed', 'validated'))]"/>
                <filter name="overdue" string="En retard"
                        domain="[('state', 'in', ('draft', 'computed', 'validated')), ('due_date', '&lt;', 'today')]"/>
                <filter name="with_issues" string="Avec anomalies bloquantes"
                        domain="[('issue_ids.severity', '=', 'blocking')]"/>
                <separator/>
                <filter name="filed" string="Déposées ou payées" domain="[('state', 'in', ('filed', 'paid'))]"/>
                <filter name="rectifications" string="Rectificatives" domain="[('rectified_id', '!=', False)]"/>
                <separator/>
                <filter name="due_date" string="Échéance" date="due_date"/>
                <filter name="period" string="Période" date="date_from"/>
                <group>
                    <filter name="group_type" string="Imprimé" context="{'group_by': 'type_id'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_due" string="Mois d'échéance" context="{'group_by': 'due_date:month'}"/>
                    <filter name="group_company" string="Société" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tableau de bord des échéances (prompt 04, 4.1) -->
    <record id="l10n_ga_declaration_action_dashboard" model="ir.actions.act_window">
        <field name="name">Échéances des déclarations</field>
        <field name="res_model">l10n_ga.declaration</field>
        <field name="view_mode">kanban,calendar,list,form</field>
        <field name="context">{'search_default_to_file': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune déclaration à déposer</p>
            <p>Les déclarations sont préparées à la validation des bulletins et dix jours avant l'échéance.</p>
        </field>
    </record>

    <record id="l10n_ga_declaration_payment_view_list" model="ir.ui.view">
        <field name="name">l10n_ga.declaration.payment.list</field>
        <field name="model">l10n_ga.declaration.payment</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="declaration_id"/>
                <field name="date"/>
                <field name="receipt_number"/>
                <field name="kind"/>
                <field name="mode"/>
                <field name="amount" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="l10n_ga_declaration_payment_view_search" model="ir.ui.view">
        <field name="name">l10n_ga.declaration.payment.search</field>
        <field name="model">l10n_ga.declaration.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="declaration_id"/>
                <field name="receipt_number"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_kind" string="Nature" context="{'group_by': 'kind'}"/>
                    <filter name="group_declaration" string="Déclaration" context="{'group_by': 'declaration_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_ga_declaration_payment_action" model="ir.actions.act_window">
        <field name="name">Quittances</field>
        <field name="res_model">l10n_ga.declaration.payment</field>
        <field name="view_mode">list</field>
    </record>

    <record id="l10n_ga_declaration_action" model="ir.actions.act_window">
        <field name="name">Déclarations</field>
        <field name="res_model">l10n_ga.declaration</field>
        <field name="view_mode">list,form,kanban,calendar</field>
    </record>
</odoo>
