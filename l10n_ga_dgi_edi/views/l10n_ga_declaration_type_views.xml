<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ga_declaration_type_view_list" model="ir.ui.view">
        <field name="name">l10n_ga.declaration.type.list</field>
        <field name="model">l10n_ga.declaration.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="authority"/>
                <field name="periodicity"/>
                <field name="generator_key"/>
                <field name="active_from" optional="show"/>
                <field name="active_to" optional="show"/>
            </list>
        </field>
    </record>

    <record id="l10n_ga_declaration_type_view_form" model="ir.ui.view">
        <field name="name">l10n_ga.declaration.type.form</field>
        <field name="model">l10n_ga.declaration.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="code"/>
                    </div>
                    <group>
                        <group string="Imprimé">
                            <field name="authority"/>
                            <field name="periodicity"/>
                            <field name="period_basis"/>
                            <field name="generator_key"/>
                            <field name="template_path"/>
                            <field name="report_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Échéance">
                            <field name="due_months"/>
                            <field name="due_day"/>
                            <field name="lead_days"/>
                            <field name="auto_create"/>
                            <field name="active_from"/>
                            <field name="active_to"/>
                        </group>
                    </group>
                    <field name="box_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="cell_ref"/>
                            <field name="value_kind"/>
                            <field name="is_total"/>
                            <field name="auto_value" optional="show"/>
                            <field name="source_codes" optional="show"/>
                            <field name="negate" optional="show"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ga_declaration_type_action" model="ir.actions.act_window">
        <field name="name">Types de déclaration</field>
        <field name="res_model">l10n_ga.declaration.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
