<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Périmètre « déclaration » du modèle unique d'anomalies (ADR-18). -->
    <record id="l10n_ga_check_issue_view_form_declaration" model="ir.ui.view">
        <field name="name">l10n_ga.check.issue.form.declaration</field>
        <field name="model">l10n_ga.check.issue</field>
        <field name="inherit_id" ref="l10n_ga_hr_payroll.l10n_ga_check_issue_view_form"/>
        <field name="arch" type="xml">
            <field name="payslip_run_id" position="before">
                <field name="declaration_id" invisible="not declaration_id"/>
            </field>
            <field name="payslip_run_id" position="attributes">
                <attribute name="invisible">not payslip_run_id</attribute>
            </field>
        </field>
    </record>

    <record id="l10n_ga_check_issue_view_search_declaration" model="ir.ui.view">
        <field name="name">l10n_ga.check.issue.search.declaration</field>
        <field name="model">l10n_ga.check.issue</field>
        <field name="inherit_id" ref="l10n_ga_hr_payroll.l10n_ga_check_issue_view_search"/>
        <field name="arch" type="xml">
            <field name="payslip_run_id" position="after">
                <field name="declaration_id"/>
            </field>
            <filter name="group_run" position="after">
                <filter name="group_declaration" string="Déclaration" context="{'group_by': 'declaration_id'}"/>
            </filter>
        </field>
    </record>

    <record id="l10n_ga_check_issue_view_list_declaration" model="ir.ui.view">
        <field name="name">l10n_ga.check.issue.list.declaration</field>
        <field name="model">l10n_ga.check.issue</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="severity == 'blocking'" decoration-warning="severity == 'warning'">
                <field name="declaration_id"/>
                <field name="severity"/>
                <field name="employee_id"/>
                <field name="message"/>
                <field name="code" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="res_model" column_invisible="1"/>
                <button name="action_open_record" type="object" string="Corriger" icon="fa-pencil"
                        invisible="not res_model"/>
            </list>
        </field>
    </record>

    <record id="l10n_ga_check_issue_action_declaration" model="ir.actions.act_window">
        <field name="name">Anomalies des déclarations</field>
        <field name="res_model">l10n_ga.check.issue</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="l10n_ga_check_issue_view_list_declaration"/>
        <field name="domain">[('scope', '=', 'declaration')]</field>
        <field name="context">{'search_default_blocking': 1}</field>
    </record>
</odoo>
