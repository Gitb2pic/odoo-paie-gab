<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        PDF des déclarations = rendu fidèle de leur classeur Excel (gabarit officiel rempli, ou classeur
        neuf mis en forme) : o._l10n_ga_excel_html() lit uniquement les valeurs figées ou stockées.
        Pas d'en-tête Odoo : l'imprimé porte le sien. Police Roboto (rapports Odoo), 96 dpi.
    -->
    <record id="paperformat_l10n_ga_declaration" model="report.paperformat">
        <field name="name">A4 imprimé DGI (Gabon)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">7</field>
        <field name="margin_bottom">7</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <!-- 96 px = 1 pouce exactement : l'imprimé est mis à l'échelle par le rendu, pas par wkhtmltopdf -->
        <field name="disable_shrinking" eval="True"/>
    </record>

    <record id="action_report_declaration" model="ir.actions.report">
        <field name="name">Déclaration (Gabon)</field>
        <field name="model">l10n_ga.declaration</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ga_dgi_edi.report_declaration</field>
        <field name="report_file">l10n_ga_dgi_edi.report_declaration</field>
        <field name="print_report_name">'Déclaration - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_l10n_ga_declaration"/>
        <field name="binding_model_id" ref="model_l10n_ga_declaration"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_declaration_page">
        <div class="article o_l10n_ga_declaration_report" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id"
             style="font-family: Roboto, Lato, 'DejaVu Sans', sans-serif;">
            <t t-out="o._l10n_ga_excel_html(page_width)"/>
            <p style="font-size: 7pt; color: #666; margin-top: 6px;">
                <span t-field="o.name"/> — <span t-field="o.state"/>
                <t t-if="o.sha256"> — empreinte SHA-256 : <span t-field="o.sha256"/></t>
            </p>
        </div>
    </template>

    <!-- A4 portrait, marges de 7 mm : 196 mm utiles à 96 dpi. -->
    <template id="report_declaration">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="page_width" t-value="715"/>
                <t t-call="l10n_ga_dgi_edi.report_declaration_page"/>
            </t>
        </t>
    </template>

    <!-- A4 paysage (états nominatifs) : 283 mm utiles. -->
    <template id="report_declaration_landscape">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="page_width" t-value="1035"/>
                <t t-call="l10n_ga_dgi_edi.report_declaration_page"/>
            </t>
        </t>
    </template>
</odoo>
